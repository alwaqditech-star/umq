# Database (MySQL)
# Docker: docker compose up -d mysql (host port 3307)
DATABASE_URL="mysql://umq:umq_dev_password@localhost:3307/umq_platform"

# Or existing local MySQL on port 3306:
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/umq_platform"

# API
API_PORT=4000
NODE_ENV=development

# Web (http = NestJS + MySQL, mock = in-memory demo)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_MODE="http"

# Auth (API)
JWT_SECRET="change-this-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
CORS_ORIGIN="http://localhost:3000"

# Seed
SEED_ADMIN_PASSWORD="ChangeMe123!"
