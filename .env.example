# Database (MySQL) — UMQ Platform schema (Prisma)
# MySQL/MariaDB port is 3306 (NOT the phpMyAdmin web port, e.g. 8181 or 8080).
# phpMyAdmin at http://localhost:8181/phpmyadmin/ is only a UI — keep DATABASE_URL on 3306.
# XAMPP / local MariaDB (user root, empty password):
DATABASE_URL="mysql://root@127.0.0.1:3306/umq_platform"

# Docker alternative: docker compose up -d mysql (host port 3307)
# DATABASE_URL="mysql://umq:umq_dev_password@localhost:3307/umq_platform"

# Legacy phpMyAdmin dump (omq_db.sql) — source for one-time data migration only:
# LEGACY_DATABASE_URL="mysql://root@127.0.0.1:3306/omq_db"

# API
API_PORT=4001
NODE_ENV=development

# Web — same-origin API proxy (/api/v1 → NestJS)
NEXT_PUBLIC_API_URL="/api/v1"
API_INTERNAL_URL="http://127.0.0.1:4001"
WEB_ORIGIN="http://localhost:3000"

# Auth (API)
JWT_SECRET="change-this-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
JWT_REFRESH_REMEMBER_EXPIRES="30d"
PASSWORD_RESET_EXPIRES="1h"
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:3000"

# Media uploads (local disk)
UPLOAD_DIR="./uploads"
PUBLIC_API_URL="http://localhost:4001/api/v1"

# Seed
SEED_ADMIN_PASSWORD="ChangeMe123!"
